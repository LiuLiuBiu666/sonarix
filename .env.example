# ============================================================
# CRYPTO HYBRID BOT — ENVIRONMENT VARIABLES
# Copy to .env (local) or paste into Railway → Variables → Raw Editor.
# NEVER commit a real .env to Git.
# ============================================================

# ─── REQUIRED ───────────────────────────────────────────────

# Binance (spot REST for candles; signed keys not strictly required for klines)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Groq LLM (sentiment analyzer)
GROQ_API_KEY=

# CoinDesk Data API (news source for sentiment)
COINDESK_API_KEY=

# Supabase (service role key has write access — use it, not anon)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Discord webhooks — 3 tiers
DISCORD_PRO_WEBHOOK_URL=
DISCORD_VIP_WEBHOOK_URL=
DISCORD_FREE_WEBHOOK_URL=

# ─── OPTIONAL (defaults shown) ──────────────────────────────

# Sentiment model
GROQ_MODEL=llama-3.1-8b-instant

# Universe + timeframes
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
TIMEFRAME=4h
SECONDARY_TIMEFRAME=1h
MTF_ENABLED=true

# Confluence + signal logic
SIGNAL_THRESHOLD=40
TECH_WEIGHT=0.6
SENTIMENT_WEIGHT=0.4
FREE_DELAY_HOURS=24

# Backtest
HISTORY_LIMIT=2000
HOLD_CANDLES=12
BACKTEST_SAVE_DB=true

# Runtime
PYTHONIOENCODING=utf-8
TZ=UTC

# Dashboard (Railway injects $PORT automatically — leave these alone there)
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8000

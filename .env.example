# ============================================================
# CRYPTO HYBRID BOT - ENVIRONMENT VARIABLES
# Sao chép file này thành .env và điền các giá trị thực
# KHÔNG BAO GIỜ commit file .env lên Git
# ============================================================

# --- BINANCE API ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# --- GOOGLE GEMINI API ---
GEMINI_API_KEY=your_gemini_api_key_here
# Model Gemini sử dụng (gemini-1.5-flash là nhanh và rẻ nhất)
GEMINI_MODEL=gemini-1.5-flash

# --- CRYPTOPANIC API ---
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# --- SUPABASE ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chế độ single channel (Phase 1 - backward compat):
TELEGRAM_CHANNEL_ID=@your_channel_username_or_-100xxxxxxxxxx

# Chế độ VIP/Free split (Phase 3A - để trống nếu không dùng):
# TELEGRAM_VIP_CHANNEL_ID=-100xxxxxxxxxx   # Kênh VIP nhận tín hiệu ngay lập tức
# TELEGRAM_FREE_CHANNEL_ID=-100yyyyyyyyyy  # Kênh Free nhận tín hiệu trễ 4 tiếng
# FREE_DELAY_HOURS=4                        # Số giờ trễ cho kênh Free

# --- CẤU HÌNH BOT ---
# Danh sách cặp giao dịch cần theo dõi (phân cách bằng dấu phẩy)
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
# Khung thời gian phân tích kỹ thuật chính
TIMEFRAME=4h
# Khung thời gian phụ cho Multi-Timeframe Analysis
SECONDARY_TIMEFRAME=1h
# Bật/tắt Multi-Timeframe Analysis (true/false)
MTF_ENABLED=true
# Ngưỡng điểm để phát lệnh BUY/SELL
SIGNAL_THRESHOLD=40
# Trọng số Technical Score (0.0 - 1.0)
TECH_WEIGHT=0.6
# Trọng số Sentiment Score (0.0 - 1.0)
SENTIMENT_WEIGHT=0.4

# --- BACKTEST ---
# Số nến lịch sử để backtest
HISTORY_LIMIT=2000
# Số nến giữ lệnh (12 nến × 4h = 48 giờ)
HOLD_CANDLES=12
# Lưu kết quả backtest vào Supabase (true/false)
BACKTEST_SAVE_DB=false

# --- DASHBOARD (Phase 4A) ---
DASHBOARD_PORT=8000
DASHBOARD_HOST=0.0.0.0
